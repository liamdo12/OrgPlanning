# Copy to apps/web/.env.local for development — Next reads env files from the
# directory it runs in, so a copy at the repository root reaches nothing.
# Never commit a filled-in copy.
#
# APP_TIER — not NODE_ENV — gates the demo-only capabilities (D12 / RT-01).
#   local      clock override + reseed allowed
#   demo       clock override + reseed allowed (deployed production build)
#   production both refused; boot fails if either flag is true
APP_TIER=local

# The application connects as `app_rw` — least privilege, exempt from the
# deny-all RLS. The migration creates it NOLOGIN on purpose, so no password is
# ever committed; give it one locally before first run:
#
#   docker exec supabase_db_occasion psql -U supabase_admin -d postgres \
#     -c "ALTER ROLE app_rw LOGIN PASSWORD 'local-dev-only';"
#
# Supabase's own `postgres` role is NOT a superuser and has no grants on the
# `app` schema, so it cannot be used here.
DATABASE_URL=postgresql://app_rw:local-dev-only@127.0.0.1:54322/postgres

# Local Supabase stack. `pnpm db:start` prints all three; `pnpm supabase status`
# reprints them. The anon key is public by design — it is meant to reach a
# browser. The service-role key bypasses every check the provider makes and must
# never leave the server; `src/lib/supabase/admin.ts` is the only thing holding
# it, behind `import "server-only"`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Google sign-in. `false` hides the button entirely — a provider button that is
# visible but unconfigured fails only after the person has committed to it.
# Turning it on also means enabling [auth.external.google] in supabase/config.toml
# and exporting SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID / _SECRET for the stack.
AUTH_GOOGLE_ENABLED=false

# Stripe TEST MODE ONLY (D10). Boot refuses anything that is not sk_test_*.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Resend, sandbox recipient — no domain verification before the live pilot (V-03).
RESEND_API_KEY=re_replace_me
EMAIL_FROM=occasion@resend.dev

# Every message goes here instead of its real recipient, whose address travels
# in the subject. Required on every tier but production, where it is refused:
# left on, it is every customer's mail arriving in one inbox and none of it
# arriving where it was addressed.
EMAIL_SANDBOX_RECIPIENT=you@example.com

# Signs the provider's delivery/open/bounce webhook (>= 16 chars).
EMAIL_WEBHOOK_SECRET=change-me-change-me

# What the platform calls itself in a message. The {{brand_name}} merge field.
BRAND_NAME=Occasion

# Absolute origin used to build single-use tokenised links in emails (D14).
APP_URL=http://localhost:3000

# Shared secret the real-clock cron presents to the jobs tick endpoint (>= 16 chars).
JOBS_TICK_SECRET=change-me-change-me

# Demo-only capabilities. Must both be false when APP_TIER=production.
ALLOW_CLOCK_OVERRIDE=true
ALLOW_DESTRUCTIVE_SEED=true
